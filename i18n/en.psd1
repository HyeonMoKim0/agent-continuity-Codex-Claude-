# en.psd1 — English overlay. Any key missing here falls back to ko.psd1.
# Select with AC_LANG=en or config.json "language": "en".
@{
    # AcContext (exception screen, plan §3.3)
    'abort.cause'       = 'ABORTED: {0}'
    'abort.preserved'   = '  Preserved  : {0}'
    'abort.recommended' = '  Recommended: {0}'

    # Start-Work.ps1
    'start.unrelatedDirty'                = 'Note: ignoring {0} change(s) outside the handoff scope (outside allowedGlobs).'
    'start.preserved.recovery'            = 'worktree kept untouched, recovery branch: {0}'
    'start.preserved.rescueSuffix'        = ', rescue bundle: {0}'
    'start.warn.rescueFail'               = 'rescue bundle creation failed (abort still holds): {0}'
    'start.abort.unpushed.cause'          = 'Probable missing Finish: this machine has unsent local changes'
    'start.abort.unpushed.recommended'    = "If this machine made those changes, run 'Finish & hand off' first (or Recover-Work.ps1)"
    'start.abort.preflight.cause'         = 'Preflight failed: {0}'
    'common.preserved.noChange'           = 'worktree unchanged'
    'common.preserved.localNoChange'      = 'local state unchanged'
    'common.preserved.worktreeKept'       = 'local worktree kept'
    'common.recommended.showStatus'       = 'Check the state with Show-Status.ps1'
    'start.alreadyActive'                 = 'This machine is already working (session {0}). Use the existing session.'
    'start.abort.staleLease.cause'        = 'A lease from this machine remains but no keeper is running'
    'start.abort.staleLease.preserved'    = 'worktree/remote state unchanged'
    'start.abort.staleLease.recommended'  = 'Diagnose with Recover-Work.ps1 -Action LeaseInfo, then recover'
    'start.abort.otherActive.cause'       = 'Another machine ({0}) is currently working'
    'start.abort.otherActive.recommended' = "Run 'Finish & hand off' on that machine first"
    'start.abort.expired.cause'           = "Another machine's ({0}) lease remains expired"
    'start.abort.expired.preserved'       = 'local and remote state unchanged'
    'start.abort.expired.recommended'     = 'Phase 1 never takes over automatically. Finish on the original machine, or run an admin diagnosis'
    'start.abort.contention.cause'        = 'Another machine just acquired the work lease first'
    'start.abort.contention.recommended'  = 'Check again shortly with Show-Status.ps1'
    'start.abort.leaseError.cause'        = 'Lease acquisition error: {0}'
    'start.abort.leaseError.recommended'  = 'Check the network and retry'
    'start.abort.chain.cause'             = 'Transaction chain verification failed: {0}'
    'start.recommended.diagnosticsReport' = 'Create a report with Recover-Work.ps1 -Action Diagnostics and inspect it'
    'start.abort.advanced.cause'          = 'remote branch advanced: branch tip ({0}) differs from the last complete transaction ({1})'
    'start.abort.advanced.recommended'    = 'Complete the transaction by finishing on the original machine'
    'start.abort.parentMismatch.cause'    = "projectHead's first parent differs from expectedProjectParent"
    'common.recommended.diagnostics'      = 'Run Recover-Work.ps1 -Action Diagnostics'
    'start.abort.ff.cause'                = 'Cannot fast-forward ({0}): no automatic rebase/merge is ever performed'
    'start.recommended.preserveOrphanCompare' = 'Run Recover-Work.ps1 -Action PreserveOrphan, then compare states'
    'start.restore.done'                  = 'Session restored: {0}'
    'start.restore.upToDate'              = 'Session is already up to date.'
    'start.restore.conflict'              = 'The local file of the same session is newer or unknown; not overwritten. Preserved: {0}'
    'start.restore.conflictHint'          = '  No automatic merge. Continue via the Git handoff (CURRENT.md).'
    'start.restore.degradedVersion'       = 'CLI version ({0}) is not in the allowlist; session restore skipped (continuing with Git handoff).'
    'start.restore.unavailable'           = 'Session snapshot unavailable ({0}) — the local session was left untouched.'
    'start.restore.skipped'               = 'Session restore skipped ({0})'
    'start.abort.initialFf.cause'         = 'Cannot fast-forward to the remote branch from the initial state'
    'start.abort.initialFf.recommended'   = 'Run Recover-Work.ps1 -Action PreserveOrphan'
    'start.abort.keeper.cause'            = 'Failed to start the lease keeper'
    'start.abort.keeper.preserved'        = 'local state unchanged (lease released)'
    'start.abort.keeper.recommended'      = 'Try again'
    'start.done'                          = 'Ready to work · current machine: {0}'
    'start.warn.releaseFail'              = 'Lease release failed during Start cleanup: {0}'

    # Finish-Work.ps1
    'finish.abort.noSession.cause'        = 'No session is in progress'
    'finish.abort.noSession.preserved'    = 'nothing changed'
    'finish.abort.noSession.recommended'  = "Run this on the machine that opened the session with 'Start work'"
    'finish.abort.ownership.cause'        = 'Remote lease ownership does not match this session'
    'finish.abort.agentStop.cause'        = 'The agent did not exit within the time limit ({0} s)'
    'finish.abort.agentStop.preserved'    = 'worktree and lease kept; no snapshot/commit'
    'finish.abort.agentStop.recommended'  = 'Close the agent yourself, then run Finish again'
    'finish.abort.tooLarge.cause'         = 'Change size ({0} bytes) exceeds maxDiffSizeBytes'
    'finish.preserved.worktreeLease'      = 'worktree and lease kept'
    'finish.abort.tooLarge.recommended'   = 'Review the profile limit or split the change'
    'finish.staged.deletedSuffix'         = ' (deleted)'
    'finish.staged.none'                  = '  - (no changes)'
    'finish.record.title'                 = '## Handoff record (automatic)'
    'finish.record.generation'            = '- generation: {0}'
    'finish.record.machine'               = '- machine: {0}'
    'finish.record.session'               = '- session: {0}'
    'finish.record.time'                  = '- time (UTC, informational): {0}'
    'finish.record.changes'               = '- changes included in this handoff:'
    'finish.warn.skipped'                 = 'Excluded from auto-commit: {0} ({1})'
    'finish.abort.snapshot.cause'         = 'Staging snapshot failed: {0}'
    'finish.abort.snapshot.recommended'   = 'Check the profile settings'
    'finish.secretFinding'                = '  possible secret: {0}:{1} [{2}]'
    'finish.abort.secret.cause'           = 'Secret detected — the push was blocked'
    'finish.abort.secret.preserved'       = 'worktree and lease kept; no commit created'
    'finish.abort.secret.recommended'     = 'Open the file to verify, or review excludedGlobs'
    'finish.abort.commit.cause'           = 'Commit object re-verification failed'
    'finish.abort.commit.preserved'       = 'quarantine branch: {0}, lease kept'
    'finish.abort.push.cause'             = 'Project push failed ({0}) — handoff incomplete'
    'finish.abort.push.preserved'         = 'lease kept, local commit preserved'
    'finish.abort.push.recommended'       = 'Check the network and run Finish again'
    'finish.warn.phase2Disabled'          = 'Session snapshot is enabled but Phase 2 encryption is inactive. Degrading to Git handoff.'
    'finish.snapshot.done'                = 'Session snapshot pushed (session: {0})'
    'finish.warn.snapshotCorrupt'         = 'Session JSONL corrupt ({0}) — continuing with Git handoff, no snapshot. A corrupt copy is preserved encrypted.'
    'finish.warn.snapshotSkipped'         = 'Session snapshot skipped ({0}) — continuing with Git handoff.'
    'finish.abort.snapPush.cause'         = 'Session snapshot push failed ({0}) — handoff incomplete'
    'finish.abort.snapPush.preserved'     = 'lease kept, local session files unchanged'
    'finish.abort.snapPush.recommended'   = 'Run Finish again'
    'finish.abort.txPush.cause'           = 'Transaction push failed ({0}) — handoff incomplete'
    'finish.abort.txPush.preserved'       = 'lease kept; Start never reads the pushed project commit'
    'finish.abort.txPush.recommended'     = 'Run Finish again to complete the transaction'
    'finish.abort.readback.cause'         = 'Remote read-back mismatch — handoff incomplete'
    'finish.abort.readback.preserved'     = 'lease kept'
    'finish.abort.readback.recommended'   = 'Check Show-Status.ps1, then retry Finish'
    'finish.abort.nonceConflict.cause'    = 'Remote lease ownership has changed (nonce conflict)'
    'finish.abort.nonceConflict.preserved' = 'handoff data is complete'
    'finish.abort.nonceConflict.recommended' = 'Report via Recover-Work.ps1 -Action LeaseInfo'
    'finish.releasePending'               = 'Handoff data complete, lease release pending'
    'finish.releasePendingHint'           = '  You can retry just the release with Recover-Work.ps1 -ProjectName {0} -Action ReleaseRetry.'
    'finish.warn.backupOverLimit'         = 'Total backup size exceeds the limit. Cleanup needed (nothing is auto-deleted).'
    'finish.done'                         = 'Handoff complete · another machine can start now'

    # Recover-Work.ps1
    'recover.lease.none'                  = 'no lease'
    'recover.keeper'                      = 'keeper: {0}'
    'keeper.running'                      = 'running'
    'keeper.none'                         = 'none'
    'recover.preserved'                   = 'Current state preserved: {0}'
    'recover.noTx'                        = 'No complete transaction exists.'
    'recover.backPreview'                 = 'This will reset the worktree to projectHead ({1}) of generation {0}.'
    'recover.backPreviewHint'             = 'The current state is preserved on a recovery branch first. Add -Force to proceed.'
    'recover.warn.rescueFail'             = 'rescue bundle creation failed: {0}'
    'recover.backDone'                    = 'Restore complete. Previous state: {0}'
    'recover.noSessionState'              = 'No session state exists.'
    'recover.noOwnTx'                     = "Cannot confirm this machine's complete transaction; not releasing."
    'recover.releaseDone'                 = 'Lease released'
    'recover.releaseFail'                 = 'Release failed: {0} — nothing is changed when ownership moved'
    'recover.takeover.needPhase2'         = 'Takeover is unavailable because Phase 2 (encryption) is not enabled.'
    'recover.takeover.needPhase2Hint'     = '  Run Enable-AgentContinuityPhase2.ps1 and retry. (In Phase 1 the only path is Finish on the original machine.)'
    'recover.takeover.noActive'           = 'No active lease. Just run Start.'
    'recover.takeover.ownLease'           = "This machine's own lease. Use Recover-Work -Action ReleaseRetry or LeaseInfo."
    'recover.takeover.stillValid'         = 'The lease is still valid (machine: {0}, expires: {1}).'
    'recover.takeover.stillValidHint'     = '  Takeover is impossible before expiry + 5 min tolerance. Finishing on the original machine is the recommended path.'
    'recover.takeover.staleInfo'          = 'Expired lease: machine={0} · generation={1} · expired={2}'
    'recover.takeover.orphanInfo'         = 'Incomplete handoff detected: remote tip ({0}) is ahead of the last complete transaction ({1}).'
    'recover.takeover.orphanHint'         = '  → The pushed-but-uncompleted commit will be adopted as a new transaction.'
    'recover.takeover.lossWarning'        = 'Expected loss: local changes/sessions never pushed from machine {0} cannot be recovered by this flow (§14).'
    'recover.takeover.forceHint'          = "Add -Force to proceed. This machine's state is preserved as an encrypted rescue bundle first."
    'recover.takeover.rescue'             = 'rescue bundle: {0}'
    'recover.takeover.diverged'           = 'The remote tip is not a fast-forward of the last complete transaction (diverged).'
    'recover.takeover.divergedHint'       = '  No automatic merge. Both states are preserved; manual comparison is required (§3.3).'
    'recover.takeover.adoptPushFail'      = 'Adoption transaction push failed ({0}) — state unchanged, retry.'
    'recover.takeover.adopted'            = 'Adopted the orphan commit as complete transaction generation {0}.'
    'recover.takeover.done'               = 'Safely taken over. Now run Start.'
    'recover.takeover.heartbeatResumed'   = 'The original machine resumed its heartbeat meanwhile. Not taken over.'
    'recover.takeover.raced'              = 'Another machine took over first. Check the state again.'
    'recover.takeover.notNeeded'          = 'Takeover unnecessary/unavailable: {0}'
    'recover.backups.none'                = 'No backups.'
    'recover.backups.entry'               = '  {0}  {1:N0} bytes'
    'recover.backups.total'               = 'Total usage: {0:N0} bytes'
    'recover.backups.overLimit'           = 'Over the limit: cleanup needed (nothing is auto-deleted).'
    'recover.needBackupFile'              = 'Specify -BackupFile.'
    'recover.verify.ok'                   = 'Backup verification passed ({0} file(s))'
    'recover.verify.fail'                 = 'Backup verification failed'
    'recover.restore.forceHint'           = 'Current files are quarantined before restore; a failure rolls back automatically. Add -Force to proceed.'
    'recover.restore.done'                = 'Restore complete ({0} file(s)) · previous files: {1}'
    'recover.restore.rolledBack'          = 'Restore failed and was rolled back automatically: {0}'
    'recover.restore.invalid'             = 'Not restored because backup verification failed.'
    'recover.restore.rollbackFail'        = 'Even the rollback failed. No further file changes are made. quarantine: {0}'
    'recover.rescue.needPhase2'           = 'Phase 2 is not enabled.'
    'recover.rescue.done'                 = 'rescue bundle created: {0} ({1} file(s))'
    'recover.diagnostics'                 = 'Diagnostics report: {0}'

    # Show-Status.ps1
    'status.noConfig'                     = 'No configuration. Run Setup-AgentContinuity.ps1 first.'
    'status.project'                      = 'Project: {0}  (machine: {1})'
    'status.lease.expiredSuffix'          = ' (expired)'
    'status.lease'                        = '  lease   : {0}{1} · owner={2} · generation={3}'
    'status.lease.none'                   = '  lease   : none'
    'status.keeper'                       = '  keeper  : {0}'
    'status.lastTx'                       = '  last complete transaction: generation={0} · machine={1}'
    'status.projectHead'                  = '  projectHead              : {0}'
    'status.lastTx.none'                  = '  last complete transaction: none (initial state)'
    'status.localHead'                    = '  local HEAD : {0}'
    'status.remoteTip'                    = '  remote tip : {0}'
    'status.dirty'                        = '  dirty      : {0} file(s)'
    'status.tipWarning'                   = '  Warning: the remote branch tip differs from the last complete transaction (Finish may be incomplete)'
    'status.noWorktree'                   = '  worktree : none ({0})'
    'status.head.none'                    = '(none)'
}
