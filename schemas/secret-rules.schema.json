{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-continuity/secret-rules.schema.json",
  "title": "Agent Continuity user secret-scan rules",
  "description": "Optional additive rules at <home>/config/secret-rules.json, merged onto the built-in secret scan rules (D3). Built-in rules can never be removed or overridden; an invalid file aborts the scan (fail-closed).",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "fileNameRules": { "$ref": "#/$defs/ruleList" },
    "contentRules": { "$ref": "#/$defs/ruleList" }
  },
  "$defs": {
    "ruleList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pattern"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
